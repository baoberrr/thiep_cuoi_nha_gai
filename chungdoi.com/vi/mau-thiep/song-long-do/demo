<script>
/* ===== PHONE FIELD INJECTOR v4 - SDT bat buoc 10 chu so ===== */
(function() {
  /* Ham kiem tra SDT hop le: dung 10 chu so */
  function isValidPhone(val) {
    var digits = val.replace(/\D/g, '');
    return digits.length === 10;
  }

  /* 1. Intercept fetch de dinh kem SDT (chi chu so) vao RSVP payload */
  var origFetch = window.fetch;
  window.fetch = async function(url, options) {
    if (typeof url === 'string' && url.includes('/rsvp') && options && options.method === 'POST') {
      try {
        var phoneEl = document.getElementById('rsvp-phone-input');
        if (phoneEl && phoneEl.value.trim()) {
          var body = JSON.parse(options.body || '{}');
          body.phone = phoneEl.value.replace(/\D/g, ''); /* Chi giu chu so */
          options = Object.assign({}, options, { body: JSON.stringify(body) });
        }
      } catch(e) {}
    }
    return origFetch.apply(this, arguments);
  };

  /* 2. Ham them SDT field vao form */
  function injectPhone() {
    if (document.getElementById('rsvp-phone-input')) return true;

    /* Tim modal dang mo: fixed inset-0 z-[9999] */
    var modal = null;
    var divs = document.getElementsByTagName('div');
    for (var i = 0; i < divs.length; i++) {
      var cls = divs[i].className || '';
      if (cls.indexOf('fixed') !== -1 && cls.indexOf('inset-0') !== -1 && cls.indexOf('9999') !== -1) {
        modal = divs[i];
        break;
      }
    }
    if (!modal) return false;

    var formDiv = modal.querySelector('[class*="overflow-y-auto"]') || modal;
    var nameInput = formDiv.querySelector('input');
    if (!nameInput) return false;
    var nameParent = nameInput.parentElement;
    if (!nameParent) return false;

    /* Tao phone wrapper */
    var wrap = document.createElement('div');
    wrap.style.marginTop = '12px';

    var lbl = document.createElement('div');
    lbl.style.cssText = 'font-size:14px;font-weight:500;margin-bottom:6px;';
    lbl.innerHTML = 'S\u1ed1 \u0111i\u1ec7n tho\u1ea1i c\u1ee7a b\u1ea1n <span style="color:#c0392b;font-weight:700">*</span>';

    var inp = document.createElement('input');
    inp.id = 'rsvp-phone-input';
    inp.type = 'tel';
    inp.inputMode = 'numeric';
    inp.autocomplete = 'tel';
    inp.placeholder = 'VD: 0912345678 (10 ch\u1eef s\u1ed1)';
    inp.maxLength = 11; /* Cho phep go khoang trang hoac dau gach */
    inp.className = nameInput.className;
    inp.style.cssText = 'display:block;width:100%;box-sizing:border-box;';

    var err = document.createElement('div');
    err.id = 'rsvp-phone-error';
    err.style.cssText = 'color:#c0392b;font-size:12px;margin-top:4px;display:none;';

    wrap.appendChild(lbl);
    wrap.appendChild(inp);
    wrap.appendChild(err);
    nameParent.parentNode.insertBefore(wrap, nameParent.nextSibling);

    /* Live validation khi dang go */
    inp.addEventListener('input', function() {
      var errEl = document.getElementById('rsvp-phone-error');
      var val = this.value.trim();
      if (!val) {
        errEl.textContent = 'Vui l\xf2ng nh\u1eadp s\u1ed1 \u0111i\u1ec7n tho\u1ea1i \u0111\u1ec3 ti\u1ebfp t\u1ee5c.';
        errEl.style.display = 'block';
        this.style.outline = '2px solid #c0392b';
      } else if (!isValidPhone(val)) {
        errEl.textContent = 'S\u1ed1 \u0111i\u1ec7n tho\u1ea1i ph\u1ea3i c\u00f3 \u0111\u00fang 10 ch\u1eef s\u1ed1.';
        errEl.style.display = 'block';
        this.style.outline = '2px solid #c0392b';
      } else {
        errEl.style.display = 'none';
        this.style.outline = '2px solid #27ae60';
      }
    });

    /* 3. Chan submit neu SDT khong hop le */
    if (!modal.dataset.validBound) {
      modal.dataset.validBound = '1';
      modal.addEventListener('click', function(e) {
        var el = e.target;
        while (el && el !== modal) {
          if (el.tagName === 'BUTTON') break;
          el = el.parentElement;
        }
        if (!el || el.tagName !== 'BUTTON') return;
        var txt = el.textContent || '';
        if (txt.indexOf('G\u1eedi') === -1 && txt.indexOf('g\u1eedi') === -1) return;

        var phoneEl = document.getElementById('rsvp-phone-input');
        var errEl = document.getElementById('rsvp-phone-error');

        if (!phoneEl || !phoneEl.value.trim()) {
          errEl.textContent = 'Vui l\xf2ng nh\u1eadp s\u1ed1 \u0111i\u1ec7n tho\u1ea1i \u0111\u1ec3 ti\u1ebfp t\u1ee5c.';
          errEl.style.display = 'block';
          if (phoneEl) { phoneEl.scrollIntoView({ behavior: 'smooth', block: 'center' }); phoneEl.focus(); phoneEl.style.outline = '2px solid #c0392b'; }
          e.stopPropagation(); e.preventDefault(); return false;
        }
        if (!isValidPhone(phoneEl.value)) {
          errEl.textContent = 'S\u1ed1 \u0111i\u1ec7n tho\u1ea1i ph\u1ea3i c\u00f3 \u0111\u00fang 10 ch\u1eef s\u1ed1.';
          errEl.style.display = 'block';
          phoneEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
          phoneEl.focus();
          phoneEl.style.outline = '2px solid #c0392b';
          e.stopPropagation(); e.preventDefault(); return false;
        }
        errEl.style.display = 'none';
        phoneEl.style.outline = '';
      }, true);
    }

    return true;
  }

  /* 4. Poll moi 300ms */
  setInterval(function() {
    if (!document.getElementById('rsvp-phone-input')) {
      injectPhone();
    }
  }, 300);

})();
</script>

<script id="guest-name-sync-script">
(function() {
  function getGuest() {
    var p = new URLSearchParams(window.location.search);
    var g = p.get('to') || p.get('u') || p.get('guest') || p.get('name') || p.get('k') || p.get('khach') || p.get('ten');
    if (g) return g.trim();
    var path = window.location.pathname.replace(/^\/thiep-cuoi-Huy-Trang\/?/, '').replace(/^\//, '');
    if (path && !path.includes('.') && !path.startsWith('api') && !path.startsWith('admin')) {
      try { return decodeURIComponent(path.replace(/[-_]/g, ' ')).trim(); } catch(e){}
    }
    return '';
  }
  function update() {
    var name = getGuest();
    var el = document.getElementById('guest-name-text');
    var box = document.getElementById('guest-name-box');
    if (name) {
      if (el) el.textContent = name;
      if (box) box.style.display = 'inline-block';
    } else {
      if (el && !el.textContent) el.textContent = 'Anh Tuấn';
    }
  }
  update();
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', update);
  }
  window.addEventListener('load', update);
  setTimeout(update, 200);
  setTimeout(update, 600);
  setTimeout(update, 1200);
})();
</script>


<script>
/* ===== BOLD NAMES INJECTOR ===== */
(function() {
  setInterval(function() {
    if (!document.body) return;
    var walker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, null, false);
    var node;
    while(node = walker.nextNode()) {
      if(node.nodeValue && (node.nodeValue.includes('Đào Quang Huy') || node.nodeValue.includes('Trần Thị Thu Trang') || node.nodeValue.includes('Đỗ Thị Thúy Vinh') || node.nodeValue.includes('Mẹ Cô Dâu'))) {
         var parent = node.parentNode;
         if (parent && parent.style && parent.tagName !== 'SCRIPT' && parent.tagName !== 'STYLE') {
             parent.style.setProperty('font-weight', 'bold', 'important');
         }
      }
    }
  }, 1000);
})();
</script>
