":{\"applying\":\"Đang áp dụng mã giảm giá...\",\"applied\":\"Đã áp dụng mã giảm giá!\",\"percentOff\":\"Giảm {percent}%\",\"referredBy\":\"Được giới thiệu bởi {name}\",\"yourCode\":\"Mã giảm giá của bạn\",\"copy\":\"Sao chép\",\"copied\":\"Đã sao chép!\",\"appliedAtCheckout\":\"Mã sẽ được tự động áp dụng khi thanh toán.\",\"continue\":\"Tiếp tục tạo thiệp cưới\",\"invalidTitle\":\"Mã giảm giá không hợp lệ\",\"invalidDesc\":\"Mã giảm giá không tồn tại hoặc đã hết hạn.\",\"backHome\":\"Về trang chủ\",\"validateError\":\"Không thể xác thực mã giảm giá\"},\"ctvLanding\":{\"badge\":\"Chương trình cộng tác viên\",\"heroTitle1\":\"Chia sẻ thiệp cưới,\",\"heroTitle2\":\"nhận hoa hồng cảm ơn\",\"heroDesc\":\"Giới thiệu Chung Đôi cho bạn bè sắp cưới — họ được giảm 20%, bạn nhận hoa hồng 20-30%. Chương trình cộng tác viên (affiliate) hoàn toàn miễn phí.\",\"whoTitle\":\"Ai nên tham gia?\",\"whoSubtitle\":\"Bất kỳ ai yêu thích Chung Đôi và muốn giúp các cặp đôi khác\",\"audience1Title\":\"Cặp đôi đã dùng Chung Đôi\",\"audience1Desc\":\"Yêu thích sản phẩm và muốn chia sẻ cho bạn bè sắp cưới — vừa giúp bạn được giảm giá, vừa nhận hoa hồng cảm ơn\",\"audience2Title\":\"Người hay được hỏi về cưới hỏi\",\"audience2Desc\":\"Bạn bè thường nhờ tư vấn về đám cưới? Chia sẻ link giới thiệu mỗi khi ai đó hỏi về thiệp cưới\",\"audience3Title\":\"KOL / Influencer\",\"audience3Desc\":\"Review và chia sẻ trải nghiệm tạo thiệp cưới online, nhận hoa hồng từ mỗi đơn hàng qua link của bạn\",\"audience4Title\":\"Content Creator\",\"audience4Desc\":\"Tạo nội dung về cưới hỏi trên TikTok, Instagram, YouTube — gắn link giới thiệu trong bio\",\"howTitle\":\"Cách thức hoạt động\",\"step1Title\":\"Đăng ký miễn phí\",\"step1Desc\":\"Chỉ cần 1 bước, nhận mã giới thiệu riêng ngay lập tức.\",\"step2Title\":\"Chia sẻ cho bạn bè\",\"step2Desc\":\"Gửi link giới thiệu khi bạn bè hỏi về thiệp cưới — họ được giảm 20% ngay.\",\"step3Title\":\"Bạn bè tạo thiệp\",\"step3Desc\":\"Bạn bè dùng mã của bạn để mua thiệp với giá ưu đãi.\",\"step4Title\":\"Nhận hoa hồng cảm ơn\",\"step4Desc\":\"Mỗi khi bạn bè thanh toán, bạn nhận 20-30% hoa hồng vào tài khoản ngân hàng.\",\"tiersTitle\":\"Hoa hồng theo cấp bậc\",\"tiersSubtitle\":\"Càng giới thiệu nhiều, hoa hồng càng tăng\",\"tierBronze\":\"Đồng\",\"tierSilver\":\"Bạc\",\"tierGold\":\"Vàng\",\"tierReferrals1\":\"0-2 giới thiệu\",\"tierReferrals2\":\"3-4 giới thiệu\",\"tierReferrals3\":\"5+ giới thiệu\",\"perInvitation\":\"Mỗi thiệp (200k):\",\"exampleTitle\":\"Ví dụ thu nhập:\",\"exampleDesc\":\"Nếu bạn giới thiệu được 10 khách hàng mua 1 thiệp (200k) mỗi tháng, bạn sẽ nhận {amount} hoa hồng (cấp Vàng - 30%).\",\"faqTitle\":\"Câu hỏi thường gặp\",\"faq1Q\":\"Tôi có cần trả phí gì không?\",\"faq1A\":\"Hoàn toàn miễn phí! Không có phí đăng ký, phí duy trì, hay bất kỳ chi phí nào. Bạn chỉ cần chia sẻ link giới thiệu và nhận hoa hồng khi bạn bè mua thiệp.\",\"faq2Q\":\"Mã giới thiệu của tôi trông như thế nào?\",\"faq2A\":\"Khi đăng ký, hệ thống sẽ tự động tạo mã giới thiệu từ tên của bạn (ví dụ: ngochan, minhphat). Bạn có thể đổi mã bất cứ lúc nào trong trang quản lý.\",\"faq3Q\":\"Bạn bè tôi được lợi gì?\",\"faq3A\":\"Bạn bè dùng mã giới thiệu của bạn sẽ được giảm 20% khi tạo thiệp cưới. Bạn giúp họ tiết kiệm, đồng thời nhận hoa hồng cảm ơn từ Chung Đôi!\",\"faq4Q\":\"Khi nào tôi nhận được hoa hồng?\",\"faq4A\":\"Hoa hồng được tính ngay khi bạn bè thanh toán thành công. Thanh toán định kỳ hàng tháng vào tài khoản ngân hàng bạn đã đăng ký.\",\"faq5Q\":\"Bạn bè mua thiệp thứ hai thì sao?\",\"faq5A\":\"Từ thiệp thứ hai trở đi, bạn bè đã được giảm 50% (chỉ còn 99k). Mã giới thiệu vẫn áp dụng thêm 20% trên giá này — bạn bè chỉ trả khoảng 79k, và bạn vẫn nhận hoa hồng 20-30% (ví dụ: 16-24k/thiệp).\",\"faq6Q\":\"Tôi là studio/wedding planner, có chương trình nào phù hợp hơn không?\",\"faq6A\":\"Nếu bạn muốn mua sỉ và tự tạo thiệp cho khách, hãy tham gia chương trình Đại lý với giá ưu đãi hơn. Chương trình CTV phù hợp cho việc giới thiệu và nhận hoa hồng.\",\"ctaTitle\":\"Sẵn sàng bắt đầu?\",\"ctaDesc\":\"Giúp bạn bè sắp cưới tiết kiệm, đồng thời nhận hoa hồng cảm ơn từ Chung Đôi\",\"ctaDisclaimer\":\"Hoàn toàn miễn phí - Không ràng buộc - Hủy bất cứ lúc nào\",\"gotoDashboard\":\"Vào trang quản lý\",\"signupBtn\":\"Đăng ký cộng tác viên\",\"signupBtnLong\":\"Đăng ký cộng tác viên ngay\"},\"blogPage\":{\"subtitle\":\"Kinh nghiệm và xu hướng thiệp cưới mới nhất\",\"readingTime\":\"{minutes} phút đọc\",\"readingTimeDefault\":\"5 phút đọc\",\"noPosts\":\"Không có bài viết nào.\",\"viewAll\":\"Xem tất cả bài viết\",\"postCount\":\"{from} - {to} / {total} bài viết\",\"toolsTitle\":\"Công cụ hữu ích\",\"tool1Title\":\"Soạn tin nhắn mời cưới\",\"tool1Desc\":\"AI giúp soạn tin mời cưới chuẩn vai vế Việt Nam\",\"tool3Title\":\"Hướng dẫn tạo thiệp\",\"tool3Desc\":\"Tạo thiệp cưới online miễn phí trong 5 phút\",\"ctaTitle\":\"Sẵn sàng tạo thiệp cưới của riêng bạn?\",\"ctaDesc\":\"Khám phá hơn 50+ mẫu thiệp đẹp, dễ dàng tùy chỉnh và chia sẻ ngay lập tức\",\"ctaBtn\":\"Xem mẫu thiệp\",\"toc\":\"Mục lục\",\"viewTemplates\":\"Xem bộ sưu tập mẫu thiệp cưới\",\"backToList\":\"Quay lại danh sách bài viết\"},\"testimonials\":{\"headingPrefix\":\"Phản hồi từ\",\"headingHighlight\":\"dâu rể\",\"subtitle\":\"Thật tuyệt khi có thể chăm sóc cho các bạn\"},\"invitationRenderer\":{\"invitationOf\":\"Thiệp của {groomName} \u0026 {brideName}\",\"brideFallback\":\"Cô dâu\",\"defaultTitle\":\"Thiệp mời\",\"notReady\":\"Thiệp hiện chưa sẵn sàng. Vui lòng liên hệ chủ thiệp để biết thêm thông tin.\",\"wantToCreate\":\"Bạn muốn tạo thiệp?\",\"startNow\":\"Bắt đầu ngay\"},\"musicPlayer\":{\"tapToPlay\":\"Chạm để phát nhạc\",\"playMusic\":\"Phát nhạc\",\"pauseMusic\":\"Tạm dừng nhạc\"},\"wishModal\":{\"title\":\"Lời chúc gợi ý cho bạn\",\"loading\":\"Đang tạo lời chúc...\",\"error\":\"Có lỗi xảy ra khi tạo lời chúc AI. Vui lòng thử lại!\",\"errorGenerate\":\"Không thể tạo lời chúc\",\"retry\":\"Thử lại\",\"selectHint\":\"Chọn một lời chúc bạ